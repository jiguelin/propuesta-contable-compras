# Copie estas líneas en Streamlit Cloud: app → ⋮ → Settings → Secrets (NO suba un secrets.toml real al repositorio).
# Postgres (Neon): neon.com → proyecto → Connect → copiar la cadena con el botón de copiar (incluye la clave).
DATABASE_URL = "postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
